{
  "name": "fct-underwriting-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx scripts/dotnet-cli.ts watch --project backend/Underwriting.Api\" \"vite --host 127.0.0.1\"",
    "build": "npm run build:web && npm run build:backend",
    "build:web": "tsc --noEmit && tsc --noEmit -p tsconfig.frontend.json && vite build",
    "build:backend": "tsx scripts/dotnet-cli.ts build backend/Underwriting.sln -p:RestoreLockedMode=true",
    "start": "tsx scripts/dotnet-cli.ts run --no-build --project backend/Underwriting.Api",
    "start:legacy": "tsx server/index.ts",
    "test": "vitest run",
    "test:dotnet": "tsx scripts/dotnet-cli.ts test backend/Underwriting.Tests --no-restore",
    "test:contracts": "tsx tests/migration/api-contracts.ts",
    "test:ui": "playwright test --config playwright.dotnet.config.ts",
    "test:ui:legacy": "playwright test",
    "test:load": "tsx tests/migration/load-check.ts",
    "contracts:generate": "tsx scripts/generate-contracts.ts",
    "lint": "tsc --noEmit -p tsconfig.frontend.json",
    "format:backend": "tsx scripts/dotnet-cli.ts format backend/Underwriting.sln --no-restore",
    "format:backend:check": "tsx scripts/dotnet-cli.ts format backend/Underwriting.sln --no-restore --verify-no-changes",
    "format": "prettier --write src scripts/dotnet*.ts scripts/generate-contracts.ts tests/migration/*.ts",
    "format:check": "prettier --check src scripts/dotnet*.ts scripts/generate-contracts.ts tests/migration/*.ts",
    "probe": "tsx scripts/probe.ts",
    "evaluate:legacy": "tsx scripts/evaluate.ts",
    "evaluate": "tsx scripts/evaluate-dotnet.ts",
    "api:demo": "tsx scripts/api-client.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^10.1.4",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@xyflow/react": "^12.8.5",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.8",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^5.0.1"
  }
}
